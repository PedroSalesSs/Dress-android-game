<?xml version="1.0" encoding="utf-8"?>
<!-- Caixa com aparência de pergaminho: degradê amarelado e borda de madeira escura -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="270"
        android:startColor="@color/pergaminho"
        android:endColor="@color/pergaminho_escuro" />

    <stroke
        android:width="3dp"
        android:color="@color/madeira_escura" />

    <corners android:radius="4dp" />

</shape>