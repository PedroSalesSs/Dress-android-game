<?xml version="1.0" encoding="utf-8"?>
<!-- Placa do título do jogo: madeira com contorno escuro, filete dourado por dentro
     e um cravo dourado em cada canto. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camada 1 (fundo): contorno externo escuro -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/madeira_escura" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Camada 2: a madeira, 3dp para dentro -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/madeira_clara"
                android:endColor="@color/madeira" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Camada 3: filete dourado, 8dp para dentro -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/dourado" />
            <corners android:radius="5dp" />
        </shape>
    </item>

    <!-- Camadas 4 a 7: cravos dourados nos quatro cantos -->
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="top|start"
        android:left="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <solid android:color="@color/dourado" />
            <stroke android:width="1dp" android:color="@color/madeira_escura" />
        </shape>
    </item>
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="top|end"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <solid android:color="@color/dourado" />
            <stroke android:width="1dp" android:color="@color/madeira_escura" />
        </shape>
    </item>
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="bottom|start"
        android:left="14dp"
        android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="@color/dourado" />
            <stroke android:width="1dp" android:color="@color/madeira_escura" />
        </shape>
    </item>
    <item
        android:width="8dp"
        android:height="8dp"
        android:gravity="bottom|end"
        android:right="14dp"
        android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="@color/dourado" />
            <stroke android:width="1dp" android:color="@color/madeira_escura" />
        </shape>
    </item>

</layer-list>
