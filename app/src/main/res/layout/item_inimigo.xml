<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de um inimigo na janela de escolha: retrato na moldura, nome e ficha.
     O fundo é a placa de madeira, que escurece ao ser pressionada. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:padding="8dp"
    android:background="@drawable/bg_madeira"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/imgInimigo"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:padding="10dp"
        android:background="@drawable/bg_moldura"
        android:scaleType="fitCenter"
        android:contentDescription="@string/descricao_img_inimigo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medieval"
            android:textColor="@color/pergaminho"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/medieval"
            android:textColor="@color/pergaminho"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
